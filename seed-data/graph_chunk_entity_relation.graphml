  <data key="d3">chunk-f2127e6741541053bf22401a69a23780</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773056643</data>
  <data key="d6"></data>
</node>
<node id="抑臭">
  <data key="d0">抑臭</data>
  <data key="d1">concept</data>
  <data key="d2">不快な匂いを抑える技術や方法。&lt;SEP&gt;不快な匂いを抑制する手法やその概念を指します。</data>
  <data key="d3">chunk-f2127e6741541053bf22401a69a23780&lt;SEP&gt;chunk-e698d00b67229e5e97d20bf4de536d42</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773059281</data>
  <data key="d6"></data>
</node>
<node id="脂肪酸">
  <data key="d0">脂肪酸</data>
  <data key="d1">concept</data>
  <data key="d2">ミズクラゲの脂質成分。飽和脂肪酸、一価不飽和脂肪酸、多価不飽和脂肪酸が含まれる。&lt;SEP&gt;リポキシゲナーゼなどによる酵素反応を経てにおい物質などを生じさせるとされている物質。&lt;SEP&gt;ミズクラゲの脂質を構成する成分で、飽和脂肪酸、一価不飽和脂肪酸、多価不飽和脂肪酸が含まれる。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936&lt;SEP&gt;chunk-ef6d0cff8796e33a156d605bc221238f&lt;SEP&gt;chunk-721fd41f3479c35d9a0169f17a35c0d4</data>
  <data key="d4">kurage_symposium&lt;SEP&gt;kurage_nioi</data>
  <data key="d5">1773059450</data>
  <data key="d6"></data>
</node>
<node id="スフィンゴ糖脂質合成試薬">
  <data key="d0">スフィンゴ糖脂質合成試薬</data>
  <data key="d1">artifact</data>
  <data key="d2">エンドグリコセラミダーゼを利用して合成が期待される試薬。&lt;SEP&gt;エンドグリコセラミダーゼの利用によって開発が期待される、スフィンゴ糖脂質を合成するための試薬。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936&lt;SEP&gt;chunk-721fd41f3479c35d9a0169f17a35c0d4</data>
  <data key="d4">kurage_symposium</data>
  <data key="d5">1773059450</data>
  <data key="d6"></data>
</node>
<node id="肥料">
  <data key="d0">肥料</data>
  <data key="d1">artifact</data>
  <data key="d2">クラゲの懸濁溶液の利用法の一つ。野菜栽培に用いられ、チンゲンサイの成長促進効果が確認されている。&lt;SEP&gt;クラゲ類の懸濁溶液から作られ、野菜の成長促進効果が認められている製品。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936&lt;SEP&gt;chunk-721fd41f3479c35d9a0169f17a35c0d4</data>
  <data key="d4">kurage_symposium</data>
  <data key="d5">1773059449</data>
  <data key="d6"></data>
</node>
