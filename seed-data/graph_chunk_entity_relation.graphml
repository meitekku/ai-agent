  <data key="d0">成分の生成</data>
  <data key="d1">method</data>
  <data key="d2">におい成分などの化合物が作られるプロセス。</data>
  <data key="d3">chunk-f2127e6741541053bf22401a69a23780</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773056638</data>
