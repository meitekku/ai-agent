  <data key="d0">生物活性の評価</data>
  <data key="d1">method</data>
  <data key="d2">物質の生物活性を測定し評価するプロセス。</data>
  <data key="d3">chunk-f2127e6741541053bf22401a69a23780</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773056640</data>
  <data key="d6"></data>
</node>
<node id="不活性化">
  <data key="d0">不活性化</data>
  <data key="d1">concept</data>
  <data key="d2">物質や生物の活動を停止させるプロセス。&lt;SEP&gt;生物学的活性や機能が停止する現象を指し、キュウリ揮発性物質による病原細菌の不活性化が研究されました。</data>
  <data key="d3">chunk-f2127e6741541053bf22401a69a23780&lt;SEP&gt;chunk-e698d00b67229e5e97d20bf4de536d42</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773059285</data>
  <data key="d6"></data>
</node>
<node id="エンドグリコセラミダーゼ">
  <data key="d0">エンドグリコセラミダーゼ</data>
  <data key="d1">concept</data>
  <data key="d2">ユウレイクラゲから発見された酵素。各種新規糖複合体およびスフィンゴ糖脂質合成試薬としての有効性が提唱されている。&lt;SEP&gt;ユウレイクラゲから発見された酵素で、新規糖複合体やスフィンゴ糖脂質合成試薬としての有効性が提唱されている。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936&lt;SEP&gt;chunk-721fd41f3479c35d9a0169f17a35c0d4</data>
  <data key="d4">kurage_symposium</data>
  <data key="d5">1773059450</data>
  <data key="d6"></data>
</node>
<node id="糖複合体">
  <data key="d0">糖複合体</data>
  <data key="d1">concept</data>
  <data key="d2">エンドグリコセラミダーゼを利用して合成が期待される物質。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936</data>
  <data key="d4">kurage_symposium</data>
  <data key="d5">1773056641</data>
  <data key="d6"></data>
</node>
