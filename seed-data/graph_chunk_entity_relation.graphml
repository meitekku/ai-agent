  <data key="d0">ヒドロペルオキシドリアーゼ経路</data>
  <data key="d1">concept</data>
  <data key="d2">オキシリピン代謝における特定の生化学的経路。&lt;SEP&gt;オキシリピン代謝の一部で、グリーンリーフ揮発性物質の生成に関与する。</data>
  <data key="d3">chunk-f2127e6741541053bf22401a69a23780&lt;SEP&gt;chunk-1bc7f3efafc1149251f1170ba46eefdd</data>
  <data key="d4">kurage_nioi</data>
  <data key="d5">1773059270</data>
  <data key="d6"></data>
</node>
<node id="チンゲンサイ">
  <data key="d0">チンゲンサイ</data>
  <data key="d1">naturalobject</data>
  <data key="d2">肥料としてクラゲの懸濁溶液を用いた野菜栽培で、成長促進効果が認められた野菜。&lt;SEP&gt;クラゲ由来の肥料で成長促進効果が認められた特定の野菜。</data>
  <data key="d3">chunk-68e696cdb4e7d95fbaf64d91da9eb936&lt;SEP&gt;chunk-721fd41f3479c35d9a0169f17a35c0d4</data>
