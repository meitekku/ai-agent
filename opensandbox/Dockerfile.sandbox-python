FROM python:3.12-slim

ENV TERM=dumb

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# System tools & CLI utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Media
    ffmpeg \
    imagemagick \
    graphviz \
    gnuplot \
    # Network & data
    curl \
    wget \
    httpie \
    jq \
    xmlstarlet \
    # Archive
    zip \
    unzip \
    # Text processing
    csvkit \
    miller \
    ripgrep \
    sed \
    gawk \
    # Document conversion
    pandoc \
    # VCS
    git \
    # WeasyPrint deps (HTML→PDF)
    libpango-1.0-0 \
    libharfbuzz0b \
    libffi-dev \
    # System
    bc \
    file \
    tree \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Install RTK (Rust Token Killer) — compresses CLI output for AI token efficiency
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then RTK_ARCH="aarch64-unknown-linux-gnu"; \
    else RTK_ARCH="x86_64-unknown-linux-gnu"; fi && \
    curl -fsSL "https://github.com/rtk-ai/rtk/releases/latest/download/rtk-${RTK_ARCH}.tar.gz" \
    | tar -xz -C /usr/local/bin/ rtk && \
    chmod +x /usr/local/bin/rtk

# Remove ImageMagick default PDF policy restriction
RUN sed -i 's/<policy domain="coder" rights="none" pattern="PDF"/<policy domain="coder" rights="read|write" pattern="PDF"/' /etc/ImageMagick-6/policy.xml 2>/dev/null || true

# Python CLI tools
RUN uv pip install --system \
    gallery-dl \
    weasyprint

# Python data/viz/ML libraries
RUN uv pip install --system \
    numpy \
    scipy \
    pandas \
    matplotlib \
    seaborn \
    plotly \
    scikit-learn \
    openpyxl \
    xlsxwriter \
    requests \
    beautifulsoup4 \
    lxml \
    feedparser \
    yfinance \
    tabulate \
    Pillow \
    pydantic \
    python-docx \
    reportlab \
    sympy

WORKDIR /workspace
