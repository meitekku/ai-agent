GEMINI_API_KEY=your-gemini-api-key-here
# Optional: enables web search tool in chat (https://tavily.com)
TAVILY_API_KEY=
# Optional: set a password to protect the app (leave empty to skip)
PW=

# CRM (optional — enables CRM/proposal tools in chat)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
KINTONE_SUBDOMAIN=
KINTONE_API_TOKEN=
KINTONE_APP_ID=

# App URL (used for email logo, links)
APP_URL=https://ai.wgzhao.me
# Scheduled Tasks — email notifications (optional)
RESEND_API_KEY=

# Vertex AI (optional — uses GCP billing/credit instead of AI Studio)
# Set USE_VERTEX_AI=true and provide a service account JSON to switch billing path
USE_VERTEX_AI=false
GCP_PROJECT_ID=
GCP_LOCATION=global
GCP_SA_KEY_FILE=./your-service-account.json
