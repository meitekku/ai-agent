GEMINI_API_KEY=your-gemini-api-key-here

# ── Gemini models (defaults baked into docker-compose.yml; override here) ──
# Chat / default LLM
GEMINI_MODEL=gemini-3.5-flash
# OCR / extraction
GEMINI_OCR_MODEL=gemini-2.5-flash
# Embedding model + dimension (Matryoshka 768)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Image generation (fallback gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Comma-separated whitelist of user-selectable models (empty = service default)
GEMINI_ALLOWED_MODELS=gemini-3.5-flash,gemini-2.5-flash

# ── Database credentials (consumed by postgres + all DATABASE_URL / PG_*) ──
PG_USER=raguser
PG_PASSWORD=ragpass

# ── Branding (env wiring only; value substitution lands in a later phase) ──
APP_NAME=Your App Name
APP_DESCRIPTION=Your app description here
APP_LOGO_URL=https://example.com/logo.png
EMAIL_BRAND=Your Brand

# ── Language / locale (defaults English; switch to ja as needed) ──
RAG_LANGUAGE=en
APP_LOCALE=en
APP_TIMEZONE=UTC

# Optional: enables web search tool in chat (https://tavily.com)
TAVILY_API_KEY=

# ── Search quality (opt-in; defaults preserve current behavior) ──
# Rerank KB retrieval with a Gemini Flash listwise reranker (server-side).
# false (default) = no rerank, identical to previous behavior.
# Server-side knobs: RERANK_MODEL (default gemini-2.5-flash),
# RETRIEVE_TOP_K (default 20, candidates retrieved), RERANK_TOP_K (default 8, kept).
RERANK_ENABLED=false
# top_k sent on KB search requests (server overrides to RETRIEVE_TOP_K when rerank on).
KB_SEARCH_TOP_K=8
# Minimum doc_count for a KB to appear in auto-discovery (1 = previous behavior).
KB_DISCOVERY_THRESHOLD=1
# Optional: set a password to protect the app (leave empty to skip)
PW=

# CRM (optional — enables CRM/proposal tools in chat)
SALESFORCE_INSTANCE_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
KINTONE_SUBDOMAIN=
KINTONE_API_TOKEN=
KINTONE_APP_ID=

# App URL (used for email logo, links, e.g. https://ai.example.com)
APP_URL=
# Scheduled Tasks — email notifications (optional)
RESEND_API_KEY=
# Email sender (e.g. MyCompany <noreply@example.com>)
EMAIL_FROM=

# Vertex AI (optional — uses GCP billing/credit instead of AI Studio)
# Set USE_VERTEX_AI=true and provide a service account JSON to switch billing path
USE_VERTEX_AI=false
GCP_PROJECT_ID=
GCP_LOCATION=global
GCP_SA_KEY_FILE=./your-service-account.json
